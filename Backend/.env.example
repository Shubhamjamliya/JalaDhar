# =================================================================
# JALADHAR BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================

# SERVER CONFIGURATION
PORT=9000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
SOCKET_CORS_ORIGIN=http://localhost:5173

# DATABASE & STORAGE
MONGODB_URI=mongodb://localhost:27017/jaladhar

# AUTHENTICATION & SECURITY (JWT)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
ADMIN_REGISTRATION_CODE=your_admin_code_here
ADMIN_NOTIFICATION_EMAILS=admin@example.com

# SECURITY & RATE LIMITING
ENABLE_RATE_LIMIT=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
OTP_RATE_LIMIT_WINDOW_MS=600000
OTP_RATE_LIMIT_MAX=5
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30
PASSWORD_RESET_MAX_ATTEMPTS=5

# CLOUDINARY (MEDIA & FILE UPLOAD)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# EMAIL / SMTP SERVICE
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Jaladhar <noreply@jaladhar.com>

# SMS TEXT MESSAGE SERVICE (SMS INDIA / DLT COMPLIANT)
ENABLE_SMS=true
SMS_INDIA_API_KEY=your_sms_india_api_key
SMS_INDIA_SENDER_ID=JALADH
SMS_INDIA_API_URL=https://api.smsindiahub.in/api/v2/SendSMS
SMS_INDIA_DEFAULT_DLT_TE_ID=your_dlt_template_id

# WHATSAPP MESSAGE SERVICE (META CLOUD API / TWILIO WHATSAPP)
ENABLE_WHATSAPP=true
WHATSAPP_CLOUD_API_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# PAYMENT GATEWAY (RAZORPAY)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# REDIS & QUEUE CONFIGURATION
ENABLE_REDIS=false
REDIS_URL_LOCAL=redis://127.0.0.1:6379
REDIS_URL_PROD=redis://user:password@host:port/0
QUEUE_RECALC_CRON="*/5 * * * *"
QUEUE_NOSHOW_CRON="*/10 * * * *"
TOKEN_QUEUE_DEFAULT_AVG_MINUTES=15
TOKEN_QUEUE_MAX_RECALLS=2

# FIREBASE PUSH NOTIFICATIONS
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY="your-private-key"
FIREBASE_WEB_PUSH_VAPID_KEY=your-vapid-key

# GOOGLE MAPS & TRANSLATION API
GOOGLE_MAPS_API_KEY=your-google-api-key
GOOGLE_TRANSLATE_API_KEY=your-google-api-key

