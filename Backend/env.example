# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/jalaDgarjaladhar

# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/jaladhar?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-in-production
JWT_REFRESH_EXPIRE=30d


# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Realtime & Queue Configuration
# To enable Redis, set ENABLE_REDIS=true.
# Redis configuration falls back based on NODE_ENV.
# For Docker or remote Redis use redis://user:password@host:port/0
ENABLE_REDIS=false
REDIS_URL_LOCAL=redis://127.0.0.1:6379
REDIS_URL_PROD=redis://user:password@host:port/0
SOCKET_CORS_ORIGIN=http://localhost:3000
TOKEN_QUEUE_DEFAULT_AVG_MINUTES=15
TOKEN_QUEUE_MAX_RECALLS=2
QUEUE_RECALC_CRON=*/5 * * * *
QUEUE_NOSHOW_CRON=*/10 * * * *

# Rate limiting
ENABLE_RATE_LIMIT=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
OTP_RATE_LIMIT_WINDOW_MS=600000
OTP_RATE_LIMIT_MAX=5

# Cloudinary Configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email Configuration (if using email service)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="Jaladhaara <noreply@jaladhaaraapp.com>"

# SMS Text Message Service Configuration (SMS India Hub / DLT Compliant)
ENABLE_SMS=true
SMS_INDIA_API_KEY=your-sms-india-api-key
SMS_INDIA_SENDER_ID=JALDHR
SMS_INDIA_ENTITY_ID=1001495841758168605
SMS_INDIA_PE_ID=1001495841758168605
SMS_INDIA_OTP_TEMPLATE_ID=1077187260026633978
SMS_INDIA_DEFAULT_DLT_TE_ID=1077187260026633978
SMS_INDIA_API_URL=https://cloud.smsindiahub.in/api/mt/SendSMS
SMS_INDIA_ROUTE=1
SMS_INDIA_CHANNEL=2

# WhatsApp Message Service Configuration (Meta Cloud API / Twilio WhatsApp)
ENABLE_WHATSAPP=true
WHATSAPP_CLOUD_API_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=100000000000000
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Admin registration safeguard
ADMIN_REGISTRATION_CODE=secure-code-to-create-admins
ADMIN_NOTIFICATION_EMAILS=admin1@example.com,admin2@example.com

# Razorpay Configuration
# For Test Mode: Use keys starting with rzp_test_...
# For Live Mode: Use keys starting with rzp_live_...
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret


# Password reset configuration
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# Firebase Cloud Messaging (SOP v3.0)
# Option 1: Individual environment variables from Service Account JSON
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_WEB_PUSH_VAPID_KEY=your-web-push-vapid-key
# Option 2 (Alternative): Path to service account JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
# Option 3 (Alternative): Entire Service Account JSON stringified
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"..."}'

# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=your-google-maps-api-key



